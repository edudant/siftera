{
  "name": "siftera",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.hosted.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "pnpm -r build",
    "build:hosted": "node scripts/build-hosted.mjs",
    "dev:hosted": "wrangler dev --ip 127.0.0.1 --port 8787",
    "emulators": "firebase emulators:start --project demo-siftera --only auth,firestore,storage",
    "test:integration": "firebase emulators:exec --project demo-siftera --only auth,firestore,storage -- \"vitest run --config vitest.integration.config.ts\"",
    "build:pages": "node scripts/build-pages.mjs",
    "demo:feed": "node scripts/build-demo-feed.mjs",
    "ingest:once": "node scripts/ingest-once.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@eslint/js": "^9.25.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "0.31.9",
    "drizzle-orm": "0.45.2",
    "eslint": "^9.25.0",
    "firebase-admin": "^13.7.0",
    "firebase-tools": "15.18.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.2",
    "wrangler": "^4.129.0"
  }
}
