{
  "schemaVersion": 1,
  "description": "Normative tool inputs. requiredScopes is Siftera metadata, strip it before SDK registration. Output DTOs are specified in MCP.md.",
  "tools": [
    {
      "name": "begin_run",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "operationId"
        ],
        "additionalProperties": false
      },
      "requiredScopes": [
        "editorial:write",
        "candidates:read",
        "preferences:read"
      ],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_editor_context",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "runId"
        ],
        "additionalProperties": false
      },
      "requiredScopes": [
        "preferences:read",
        "feedback:read",
        "history:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list_candidates",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "cursor": {
            "type": "string",
            "maxLength": 2048
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 20
          }
        },
        "required": [
          "runId"
        ],
        "additionalProperties": false
      },
      "requiredScopes": [
        "candidates:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_candidate_content",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        },
        "required": [
          "runId",
          "candidateId",
          "revision"
        ],
        "additionalProperties": false
      },
      "requiredScopes": [
        "candidates:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "submit_editorial_results",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://siftera.local/schemas/editorial-result.v1.json",
        "title": "Siftera EditorialSubmission v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "batchId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "editor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "client": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "model": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "promptVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "client",
              "model",
              "promptVersion"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/item"
            },
            "maxItems": 10
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "candidate": {
                  "$ref": "#/$defs/candidateRef"
                },
                "reason": {
                  "enum": [
                    "irrelevant",
                    "low_value",
                    "duplicate_story",
                    "already_seen",
                    "insufficient_content"
                  ]
                }
              },
              "required": [
                "candidate",
                "reason"
              ]
            },
            "maxItems": 80
          }
        },
        "required": [
          "schemaVersion",
          "runId",
          "batchId",
          "editor",
          "items",
          "rejected"
        ],
        "$defs": {
          "candidateRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "candidateId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "candidateId",
              "revision"
            ]
          },
          "item": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "candidate": {
                "$ref": "#/$defs/candidateRef"
              },
              "relatedCandidates": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/candidateRef"
                },
                "maxItems": 5
              },
              "presentation": {
                "enum": [
                  "article",
                  "long_read",
                  "distilled_fact",
                  "school_notice",
                  "video",
                  "audio",
                  "discovery",
                  "learning",
                  "recommendation",
                  "short_fun"
                ]
              },
              "headline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "summary": {
                "type": "string",
                "maxLength": 800
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                },
                "maxItems": 5,
                "minItems": 1,
                "uniqueItems": true
              },
              "assessment": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "relevance": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "quality": {
                    "enum": [
                      "useful",
                      "thin",
                      "unknown"
                    ]
                  },
                  "novelty": {
                    "enum": [
                      "new",
                      "update",
                      "repeat"
                    ]
                  },
                  "basis": {
                    "enum": [
                      "full_text",
                      "excerpt",
                      "metadata"
                    ]
                  }
                },
                "required": [
                  "relevance",
                  "quality",
                  "novelty",
                  "basis"
                ]
              },
              "whyIncluded": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "openOriginal": {
                "type": "boolean"
              },
              "distilledText": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidenceQuote": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "schoolDetails": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "homework",
                        "test",
                        "learning_topic",
                        "teacher_link",
                        "announcement"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "dueDate": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "subject": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "origin": {
                      "enum": [
                        "teacher",
                        "ai_suggestion"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "text",
                    "dueDate",
                    "subject",
                    "origin"
                  ]
                },
                "maxItems": 20
              }
            },
            "required": [
              "candidate",
              "relatedCandidates",
              "presentation",
              "headline",
              "summary",
              "topics",
              "assessment",
              "whyIncluded",
              "openOriginal",
              "distilledText",
              "evidenceQuote",
              "schoolDetails"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "presentation": {
                      "const": "distilled_fact"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "distilledText": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "evidenceQuote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "assessment": {
                      "properties": {
                        "basis": {
                          "const": "full_text"
                        }
                      }
                    },
                    "openOriginal": {
                      "const": false
                    }
                  }
                },
                "else": {
                  "properties": {
                    "distilledText": {
                      "type": "null"
                    },
                    "evidenceQuote": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "presentation": {
                      "not": {
                        "const": "school_notice"
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "schoolDetails": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "requiredScopes": [
        "editorial:write"
      ],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "publish_feed",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "orderedCandidateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "maxItems": 50,
            "uniqueItems": true
          }
        },
        "required": [
          "runId",
          "operationId",
          "orderedCandidateIds"
        ],
        "additionalProperties": false
      },
      "requiredScopes": [
        "feed:publish"
      ],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "abort_run",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "reason": {
            "enum": [
              "cancelled",
              "upstream_failure"
            ]
          }
        },
        "required": [
          "runId",
          "operationId",
          "reason"
        ],
        "additionalProperties": false
      },
      "requiredScopes": [
        "editorial:write"
      ],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
