{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siftera.local/schemas/editorial-result.v1.json",
  "title": "Siftera EditorialSubmission v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "batchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "client",
        "model",
        "promptVersion"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 10
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate": {
            "$ref": "#/$defs/candidateRef"
          },
          "reason": {
            "enum": [
              "irrelevant",
              "low_value",
              "duplicate_story",
              "already_seen",
              "insufficient_content"
            ]
          }
        },
        "required": [
          "candidate",
          "reason"
        ]
      },
      "maxItems": 80
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "batchId",
    "editor",
    "items",
    "rejected"
  ],
  "$defs": {
    "candidateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "candidateId",
        "revision"
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "$ref": "#/$defs/candidateRef"
        },
        "relatedCandidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidateRef"
          },
          "maxItems": 5
        },
        "presentation": {
          "enum": [
            "article",
            "long_read",
            "distilled_fact",
            "school_notice",
            "video",
            "audio",
            "discovery",
            "learning",
            "recommendation",
            "short_fun"
          ]
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "summary": {
          "type": "string",
          "maxLength": 800
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "maxItems": 5,
          "minItems": 1,
          "uniqueItems": true
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "relevance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "quality": {
              "enum": [
                "useful",
                "thin",
                "unknown"
              ]
            },
            "novelty": {
              "enum": [
                "new",
                "update",
                "repeat"
              ]
            },
            "basis": {
              "enum": [
                "full_text",
                "excerpt",
                "metadata"
              ]
            }
          },
          "required": [
            "relevance",
            "quality",
            "novelty",
            "basis"
          ]
        },
        "whyIncluded": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "emphasis": {
          "enum": [
            "lead",
            "standard",
            "compact",
            "text"
          ],
          "description": "Jak výrazně se položka ukáže ve feedu. Volitelné; bez ní si klient odvodí důraz z prezentace a hodnocení."
        },
        "openOriginal": {
          "type": "boolean"
        },
        "distilledText": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceQuote": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "schoolDetails": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "homework",
                  "test",
                  "learning_topic",
                  "teacher_link",
                  "announcement"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "dueDate": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "subject": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "origin": {
                "enum": [
                  "teacher",
                  "ai_suggestion"
                ]
              }
            },
            "required": [
              "kind",
              "text",
              "dueDate",
              "subject",
              "origin"
            ]
          },
          "maxItems": 20
        }
      },
      "required": [
        "candidate",
        "relatedCandidates",
        "presentation",
        "headline",
        "summary",
        "topics",
        "assessment",
        "whyIncluded",
        "openOriginal",
        "distilledText",
        "evidenceQuote",
        "schoolDetails"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "presentation": {
                "const": "distilled_fact"
              }
            }
          },
          "then": {
            "properties": {
              "distilledText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "evidenceQuote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "assessment": {
                "properties": {
                  "basis": {
                    "const": "full_text"
                  }
                }
              },
              "openOriginal": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "distilledText": {
                "type": "null"
              },
              "evidenceQuote": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "presentation": {
                "not": {
                  "const": "school_notice"
                }
              }
            }
          },
          "then": {
            "properties": {
              "schoolDetails": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
